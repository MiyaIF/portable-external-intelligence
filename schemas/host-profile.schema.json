{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/portable-external-intelligence/schemas/host-profile.schema.json",
  "title": "Machine-local compatible CLI host profile",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "host_family": {"const": "codex-compatible"},
            "adapter_id": {"const": "codex-cli"}
          }
        },
        {
          "properties": {
            "host_family": {"const": "claude-compatible"},
            "adapter_id": {"const": "claude-code"}
          }
        },
        {
          "properties": {
            "host_family": {"const": "gemini-compatible"},
            "adapter_id": {"const": "gemini-cli"}
          }
        },
        {
          "properties": {
            "host_family": {"const": "qwen-compatible"},
            "adapter_id": {"const": "qwen-code"}
          }
        }
      ]
    }
  ],
  "required": [
    "schema_version",
    "host_id",
    "display_name",
    "host_family",
    "adapter_id",
    "executable_names",
    "hook_config_path",
    "global_context_path",
    "skill_roots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"type": "string", "pattern": "^(?!codex$|claude$|gemini$|qwen$|codex-cli$|claude-code$|gemini-cli$|qwen-code$|codex-app$)(?!\\.|.*[. ]$)(?!con(?:\\..*)?$|prn(?:\\..*)?$|aux(?:\\..*)?$|nul(?:\\..*)?$|com[1-9](?:\\..*)?$|lpt[1-9](?:\\..*)?$)[a-z0-9][a-z0-9._-]{0,159}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "host_family": {"type": "string", "enum": ["codex-compatible", "claude-compatible", "gemini-compatible", "qwen-compatible"]},
    "adapter_id": {"type": "string", "enum": ["codex-cli", "claude-code", "gemini-cli", "qwen-code"]},
    "executable_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,127}$"}
    },
    "hook_config_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
    "global_context_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
    "skill_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"}
    }
  }
}
