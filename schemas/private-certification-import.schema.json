{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiyaIF/portable-external-intelligence/blob/main/schemas/private-certification-import.schema.json",
  "title": "Private certification import",
  "description": "A path-free, sanitized receipt from a private real-host certification run.",
  "type": "object",
  "required": [
    "receipt_type",
    "public_subject_commit_sha",
    "host_id",
    "os_profile",
    "mode",
    "status",
    "artifact_sha256",
    "event_sha256",
    "source_receipt_sha256",
    "certified_at",
    "import_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "private_certification_import"},
    "public_subject_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host_id": {"type": "string", "enum": ["codex-cli", "codex-app", "claude-code", "gemini-cli", "qwen-code"]},
    "os_profile": {"type": "string", "enum": ["windows-10", "windows-11", "macos-current", "ubuntu-24.04", "debian-12"]},
    "mode": {"const": "real"},
    "status": {"const": "PASSED"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "certified_at": {"type": "string", "format": "date-time"},
    "import_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
