{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "This schema validates structure only. Final semantic acceptance requires ei.journal.validate_schema(\"capture-receipt\", value). candidate_hashes may be partial, each ID must belong to candidate_ids, and one ID may map to at most one content hash.",
  "x-runtime-semantic-validator": "ei.journal.validate_schema(\"capture-receipt\", value)",
  "x-candidate-hashes-semantics": {
    "partial": true,
    "id_membership": "candidate_ids",
    "max_hashes_per_id": 1
  },
  "type": "object",
  "required": ["capture_id", "state", "candidate_ids", "covered_target_ids", "reason_code", "updated_at"],
  "properties": {
    "capture_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"enum": ["WAITING", "SECURED", "EVALUATED_NONE", "UNAVAILABLE", "UNKNOWN"]},
    "candidate_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|queue_[0-9a-f]{32}|evt_[0-9TZ]+_[0-9a-f]{12}|cand_[0-9a-f]{20})$"},
      "uniqueItems": true
    },
    "covered_target_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "updated_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "candidate_hashes": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|queue_[0-9a-f]{32}|evt_[0-9TZ]+_[0-9a-f]{12}|cand_[0-9a-f]{20})$"},
          {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "uniqueItems": true
    },
    "closeout_proofs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["record_id", "target_set_hash", "content_hash", "binding_digest", "result_digest"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^co_[0-9a-f]{64}$"},
          "target_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "SECURED"}}, "required": ["state"]},
      "then": {"properties": {"candidate_ids": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
