{
  "type": "object",
  "properties": {
    "decision": {"type": "string", "enum": ["YES", "NO"]},
    "reason_code": {"type": "string", "enum": ["evidence_verified", "evidence_repeated", "novel_structure", "project_specific", "one_off_fact", "no_evidence", "no_future_benefit", "duplicate_without_new_evidence", "secret_or_confidential", "transient_state", "already_encoded"]},
    "candidate_title": {"type": "string", "minLength": 1},
    "candidate_claim": {"type": "string", "minLength": 20},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "benefit": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "applicability_scope": {"type": "string", "enum": ["universal", "family", "host"]},
    "applicable_host_ids": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"}},
    "applicable_host_families": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"}}
  },
  "required": ["decision", "reason_code", "candidate_title", "candidate_claim", "evidence_refs", "benefit", "classification", "confidence", "applicability_scope", "applicable_host_ids", "applicable_host_families"],
  "additionalProperties": false
}
