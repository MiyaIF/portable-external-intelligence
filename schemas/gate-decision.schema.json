{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "reason_code", "candidate_title", "candidate_claim", "evidence_refs", "benefit", "classification", "confidence"],
  "properties": {
    "decision": {"type": "string", "enum": ["YES", "NO"]},
    "reason_code": {"type": "string", "minLength": 1},
    "candidate_title": {"type": "string", "minLength": 1},
    "candidate_claim": {"type": "string", "minLength": 20},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "benefit": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "applicability_scope": {"type": "string", "enum": ["universal", "family", "host"]},
    "applicable_host_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"}},
    "applicable_host_families": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"}},
    "source_host_id": {"type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"},
    "source_host_family": {"type": "string", "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"},
    "processing_state": {"type": "string", "maxLength": 80},
    "retry_after_seconds": {"type": ["integer", "null"], "minimum": 0},
    "next_eligible_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "YES"}}},
      "then": {
        "required": ["applicability_scope", "applicable_host_ids", "applicable_host_families"],
        "allOf": [
          {"if": {"properties": {"applicability_scope": {"const": "universal"}}}, "then": {"properties": {"applicable_host_ids": {"maxItems": 0}, "applicable_host_families": {"maxItems": 0}}}},
          {"if": {"properties": {"applicability_scope": {"const": "family"}}}, "then": {"properties": {"applicable_host_ids": {"maxItems": 0}, "applicable_host_families": {"minItems": 1}}}},
          {"if": {"properties": {"applicability_scope": {"const": "host"}}}, "then": {"properties": {"applicable_host_ids": {"minItems": 1}, "applicable_host_families": {"maxItems": 0}}}}
        ]
      }
    }
  ],
  "additionalProperties": false
}
