{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/portable-external-intelligence/skills/team-routing-decision.schema.json",
  "title": "Team routing decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "claim", "scope", "preconditions", "failure_modes", "benefit", "classification"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "claim": {"type": "string", "minLength": 20, "maxLength": 1200},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_modes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "benefit": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "private-reusable"]}
  }
}
