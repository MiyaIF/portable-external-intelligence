{
  "schema_version": 1,
  "include": [
    ".gitattributes",
    ".gitignore",
    ".github/CODEOWNERS",
    ".github/dependabot.yml",
    ".github/ISSUE_TEMPLATE/**",
    ".github/pull_request_template.md",
    ".github/workflows/**",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "config/*.json",
    "docs/**/*.md",
    "hooks/**",
    "policies/*.json",
    "pyproject.toml",
    "release/README.md",
    "release/completion-report.md",
    "release/evidence-manifest.json",
    "release/publication-completion-report.md",
    "release/publication-policy.json",
    "release/security-remediation-report.md",
    "requirements-*.in",
    "requirements-*.lock",
    "schemas/*.json",
    "scripts/**/*.py",
    "scripts/**/*.ps1",
    "scripts/**/*.sh",
    "skills/external-intelligence/**",
    "src/**/*.py",
    "templates/context/**",
    "templates/global-agents.external-intelligence.md",
    "templates/knowledge-repository/**",
    "tests/**/*.py",
    "tests/fixtures/**"
  ],
  "exclude": [
    "AGENTS.md",
    ".superpowers/**",
    "artifacts/**",
    "build/**",
    "docs/superpowers/**",
    "hooks/hooks.template.json",
    "ops-private-template/**",
    "release/scanner-receipts/**",
    "release/task-baseline.json",
    "tests/acceptance/test_implementation_plan_contract.py"
  ],
  "text_suffixes": [
    ".bash",
    ".cfg",
    ".cmd",
    ".gitattributes",
    ".gitignore",
    ".ini",
    ".in",
    ".json",
    ".lock",
    ".md",
    ".ps1",
    ".psm1",
    ".py",
    ".sh",
    ".toml",
    ".txt",
    ".yml",
    ".yaml"
  ],
  "executable_patterns": [
    "scripts/**/*.sh"
  ],
  "required_paths": [
    "LICENSE",
    "README.md",
    "config/public-export-allowlist.json",
    "release/publication-policy.json",
    "scripts/certify-public-clone.py",
    "scripts/create-public-export.py",
    "src/ei/public_export.py"
  ]
}
